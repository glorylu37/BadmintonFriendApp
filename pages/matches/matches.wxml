<view class="page">
  <text class="title">附近球局</text>
  <text class="subtitle">后续会根据测评标签推荐实力相近的球友。</text>
  <view wx:for="{{matches}}" wx:key="title" class="card">
    <text class="card-title">{{item.title}}</text>
    <text class="detail">{{item.place}} · {{item.time}}</text>
    <text class="level">适合：{{item.level}}</text>
  </view>
</view>
