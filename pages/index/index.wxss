.page { padding: 40rpx 32rpx 56rpx; }
.hero { padding: 32rpx 8rpx 44rpx; }
.eyebrow { color: #0b6e4f; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.title { display: block; margin-top: 16rpx; font-size: 52rpx; font-weight: 700; line-height: 1.25; }
.subtitle { display: block; margin-top: 18rpx; color: #607067; font-size: 28rpx; line-height: 1.6; }
.profile, .section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-sizing: border-box; }
.profile { display: flex; align-items: center; }
.avatar { width: 82rpx; height: 82rpx; border-radius: 50%; background: #0b6e4f; color: #fff; text-align: center; line-height: 82rpx; font-size: 36rpx; font-weight: 700; margin-right: 22rpx; }
.name { font-size: 34rpx; font-weight: 700; }
.level { margin-top: 8rpx; color: #607067; font-size: 26rpx; }
.section-title { font-weight: 700; margin-bottom: 20rpx; }
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { padding: 12rpx 18rpx; background: #e3f1ea; color: #0b6e4f; border-radius: 999rpx; font-size: 25rpx; }
.primary, .secondary { height: 92rpx; line-height: 92rpx; border-radius: 14rpx; font-size: 30rpx; margin-top: 18rpx; }
.primary { background: #0b6e4f; color: #fff; }
.secondary { background: #fff; color: #0b6e4f; }
.hint { margin: 32rpx 8rpx 0; color: #849189; font-size: 23rpx; line-height: 1.6; }
